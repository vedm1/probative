# Copy to .env and fill in what you use. .env is gitignored — never commit it.
# Probative talks to an LLM provider through probative.llm (a LiteLLM-backed
# adapter); set the key for whichever provider you point `model` at.

# Anthropic (default provider)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# The model string passed to the provider adapter, LiteLLM's "<provider>/<model>" form.
MODEL=anthropic/claude-sonnet-5

# `probative mcp` only: folders the MCP tool may read from and write reports to
# (os.pathsep-separated; default is the server's working directory).
PROBATIVE_MCP_ROOTS=

# Claude plugin only: the plugin passes the key you set with `/plugin configure
# probative@probative` under this name, so it never overwrites ANTHROPIC_API_KEY. Leave it
# empty; a literal `${...}` placeholder is treated as unset.
PROBATIVE_PLUGIN_ANTHROPIC_KEY=
